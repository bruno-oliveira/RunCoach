# Environment Variables for RunCoach

# Application Settings
APP_NAME=RunCoach
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=sqlite:///./runcoach.db

# Logging
LOG_LEVEL=INFO

# Training Plan Constraints
MIN_WEEKS_5K=4
MIN_WEEKS_10K=6
MIN_WEEKS_HALF=8
MIN_WEEKS_30K=6
MIN_WEEKS_MARATHON=12

MAX_WEEKS_5K=16
MAX_WEEKS_10K=16
MAX_WEEKS_HALF=20
MAX_WEEKS_30K=20
MAX_WEEKS_MARATHON=24

MIN_MILEAGE_5K=5.0
MIN_MILEAGE_10K=10.0
MIN_MILEAGE_HALF=15.0
MIN_MILEAGE_30K=15.0
MIN_MILEAGE_MARATHON=25.0

# OAuth / Authentication
SECRET_KEY=your-secret-key-change-in-production-for-real-deployment
GOOGLE_CLIENT_ID=your-google-client-id-from-google-cloud-console

# Intervals.icu OAuth activity sync
INTERVALS_CLIENT_ID=your-intervals-client-id
INTERVALS_CLIENT_SECRET=your-intervals-client-secret
INTERVALS_REDIRECT_URI=http://localhost:8000/api/intervals/callback
INTERVALS_INITIAL_SYNC_DAYS=365
