# ---------------------------------------------------------------------------
# RunCoach environment variables
#
# Copy to `.env` and fill in. Everything here has a safe default except
# SECRET_KEY and GOOGLE_CLIENT_ID, which the app requires to start.
# Every integration is off-by-default: leave a section blank and the feature
# degrades cleanly rather than failing.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=RunCoach
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./runcoach.db

# --- Auth (required) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=
# From https://console.cloud.google.com → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# --- Secrets at rest ---
# Fernet key encrypting stored OAuth tokens. REQUIRED in production and must
# differ from SECRET_KEY; only in DEBUG does it fall back to SECRET_KEY.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Read on decryption only, so keys can be rotated without rewriting rows.
ENCRYPTION_KEY_PREVIOUS=

# --- Intervals.icu activity sync (optional) ---
# Unset: no activity import; plans still generate and adapt from manual entries.
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
INTERVALS_REDIRECT_URI=http://localhost:8000/api/intervals/callback
INTERVALS_INITIAL_SYNC_DAYS=365

# --- Coach's Note (optional) ---
# Unset: the note is generated by the deterministic rules engine instead.
ANTHROPIC_API_KEY=
COACH_AI_MODEL=claude-haiku-4-5

# --- Admin console (optional) ---
# The single operator email allowed to reach /admin and /api/admin/*.
# Empty means no admin: the gate fails closed.
ADMIN_EMAIL=

# --- Outbound nudge email (optional) ---
# Empty SMTP_HOST means send nothing — the null mailer logs and reports
# failure rather than pretending. Port 465 uses implicit TLS; otherwise
# STARTTLS unless SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NUDGE_MIN_INTERVAL_DAYS=4

# --- Scheduled jobs (optional) ---
# Shared secret for /api/scheduled/sync and /api/notifications/run.
# Empty makes both endpoints 404.
CRON_SECRET=
# Absolute origin for links inside emails. Must be set in production.
PUBLIC_BASE_URL=http://localhost:8000

# --- Training plan constraints ---
MIN_WEEKS_5K=4
MIN_WEEKS_10K=6
MIN_WEEKS_HALF=8
MIN_WEEKS_30K=6
MIN_WEEKS_MARATHON=12

MAX_WEEKS_5K=16
MAX_WEEKS_10K=16
MAX_WEEKS_HALF=20
MAX_WEEKS_30K=20
MAX_WEEKS_MARATHON=24

MIN_MILEAGE_5K=5.0
MIN_MILEAGE_10K=10.0
MIN_MILEAGE_HALF=15.0
MIN_MILEAGE_30K=15.0
MIN_MILEAGE_MARATHON=25.0
